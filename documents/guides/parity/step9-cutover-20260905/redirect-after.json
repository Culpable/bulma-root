  "name": "Bulma canonical redirects",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "preserve_query_string": true,
          "status_code": 308,
          "target_url": {
            "expression": "concat(\"https://bulma.com.au\", http.request.uri.path)"
          }
        }
      },
      "description": "Redirect www to the Bulma apex",
      "enabled": true,
      "expression": "(http.host eq \"www.bulma.com.au\")",
