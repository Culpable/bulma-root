{
  "name": "bulma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "precheck": "wrangler types",
    "check": "astro check",
    "prebuild": "wrangler types",
    "build": "astro check && astro build && node scripts/generate-agent-markdown.mjs dist https://bulma.com.au && node scripts/generate-headers.mjs",
    "preview": "astro preview",
    "preview:static": "node scripts/preview-server.mjs",
    "test": "pnpm test:unit && pnpm test:build-output && playwright test",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "test:build-output": "node scripts/validate-build.mjs && node scripts/report-performance-budgets.mjs && node scripts/verify-trust-pages.mjs",
    "test:e2e": "playwright test",
    "test:agent-a11y": "playwright test test/agent-accessibility.spec.ts",
    "test:http": "node scripts/run-http-contract.mjs",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload --env preview"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "astro": "7.3.1",
    "clsx": "2.1.1",
    "mixpanel-browser": "2.73.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.1.18",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.19.13",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "pixelmatch": "7.1.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
